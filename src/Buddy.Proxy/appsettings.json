{
  "DeepSeek": {
    "BaseUrl": "https://api.deepseek.com/",
    "ChatPath": "chat/completions",
    "ApiKey": "",
    "RequestTimeoutSeconds": 180
  },
  "Proxy": {
    "DatabasePath": "data/buddy-proxy.db",
    "KeyPepper": "",
    "DefaultReplyLimit": 1000,
    "DefaultTokenLimit": 1000000,
    "MaximumCompletionTokens": 4096,
    "MaximumRequestBytes": 2097152,
    "AllowedModels": [
      "deepseek-v4-flash",
      "deepseek-v4-pro"
    ]
  },
  "Telegram": {
    "Enabled": false,
    "ApiBaseUrl": "https://api.telegram.org/",
    "BotToken": "",
    "ChatId": "",
    "RequestTimeoutSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
