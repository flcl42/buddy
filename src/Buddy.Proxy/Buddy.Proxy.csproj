<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>buddy-proxy</AssemblyName>
    <RootNamespace>Buddy.Proxy</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <DefineConstants>$(DefineConstants);BUDDY_SYSTEM_SQLITE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Buddy.Proxy.Tests" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.provider.dynamic_cdecl" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3"
                      Condition="'$(RuntimeIdentifier)' != 'linux-x64'" />
  </ItemGroup>
</Project>
