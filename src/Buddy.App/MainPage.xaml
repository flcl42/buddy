                                                            PauseCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Dialog.PauseDialogAudioCommand}"
                                                            PlayCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Dialog.PlayWordAudioCommand}"
                                                            ResetCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Dialog.RestartDialogAudioCommand}"
                                                            State="{Binding WordAudioState}"
                                                            StopCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Dialog.StopDialogAudioCommand}"
                                                            Subject="{Binding WordAudioSubject}" />
                                                        <Button
                                                            Grid.Column="3"
                                                            AutomationId="DismissWordLookupButton"
                                                            BackgroundColor="Transparent"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Dialog.DismissWordLookupCommand}"
                                                            CommandParameter="{Binding .}"
                                                            FontSize="16"
                                                            HeightRequest="24"
                                                            Padding="3,0"
                                                            Text="×"
                                                            TextColor="#777B8D"
                                                            WidthRequest="24" />
                                                    </Grid>
                                                    <HorizontalStackLayout Spacing="8">
                                                        <Label
                                                            FontFamily="Segoe UI"
                                                            FontSize="12"
                                                            Text="{Binding WordPhoneticText}"
                                                            TextColor="#4F50C8" />
                                                        <Label
                                                            FontAttributes="Italic"
                                                            FontSize="11"
                                                            IsVisible="{Binding HasWordPartOfSpeech}"
                                                            Text="{Binding WordPartOfSpeechText}"
                                                            TextColor="#777B8D" />
                                                    </HorizontalStackLayout>
                                                    <Label
                                                        FontSize="11"
                                                        IsVisible="{Binding IsWordPhoneticLoading}"
                                                        Text="{DynamicResource PreparingPhonetics}"
                                                        TextColor="#777B8D" />
                                                    <Label
