                                                BackgroundColor="#FAFAFD"
                                                IsVisible="{Binding HasPronunciation}"
                                                Stroke="#DFE1EA"
                                                StrokeShape="RoundRectangle 9">
                                                <VerticalStackLayout Spacing="7">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <Label
                                                            FontFamily="Segoe UI Semibold"
                                                            FontSize="10"
                                                            Text="{DynamicResource PronunciationLabel}"
                                                            TextColor="#6668B8" />
                                                        <Label
                                                            Grid.Column="1"
                                                            FontSize="9"
                                                            Text="{Binding PronunciationSummary}"
                                                            TextColor="#777C8F" />
                                                    </Grid>
                                                    <Label
