                            Grid.Row="1"
                            Margin="0,14,0,10">
                            <CollectionView
                                x:Name="DialogMessages"
                                HandlerChanged="OnDialogMessagesHandlerChanged"
                                ItemSizingStrategy="MeasureAllItems"
                                ItemsSource="{Binding Dialog.Messages}"
                                ItemsUpdatingScrollMode="KeepScrollOffset"
                                Scrolled="OnDialogMessagesScrolled"
                                SelectionMode="None"
                                VerticalScrollBarVisibility="Default">
                            <CollectionView.EmptyView>
                                <VerticalStackLayout
                                    Padding="30"
                                    HorizontalOptions="Center"
                                    Spacing="9"
                                    VerticalOptions="Center">
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        FontSize="28"
                                        Text="◌"
                                        TextColor="#B4B7C5" />
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource MutedText}"
                                        Text="{DynamicResource DialogEmptyHint}" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="cards:DialogMessageViewModel">
                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="14,12"
                                        BackgroundColor="#F5F6FA"
                                        Stroke="#E1E4EB"
                                        StrokeShape="RoundRectangle 12">
                                        <Border.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsUser}"
                                                TargetType="Border"
                                                Value="True">
                                                <Setter Property="BackgroundColor" Value="#EFEEFF" />
                                                <Setter Property="Stroke" Value="#DAD8FF" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <VerticalStackLayout Spacing="7">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Label
                                                    FontFamily="Segoe UI Semibold"
                                                    FontSize="11"
                                                    Text="{Binding ProviderText}"
                                                    TextColor="#5B5CE2" />
                                                <Label
                                                    Grid.Column="1"
                                                    FontSize="10"
                                                    Text="{Binding TimeText}"
                                                    TextColor="#9296A6" />
                                            </Grid>
                                            <controls:MarkdownMessageView
                                                CommandContext="{Binding .}"
                                                Document="{Binding RenderedContent}"
                                                WordClickedCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Dialog.LookupWordCommand}" />
                                            <Border
                                                Padding="11,9"
                                                BackgroundColor="#FFFDF5"
                                                IsVisible="{Binding IsWordLookupVisible}"
                                                SemanticProperties.Description="{DynamicResource WordHelpTitle}"
                                                Stroke="#DED8B7"
                                                StrokeShape="RoundRectangle 9">
                                                <VerticalStackLayout Spacing="6">
                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                                                        <Label
                                                            FontFamily="Segoe UI Semibold"
                                                            FontSize="13"
                                                            Text="{Binding SelectedWord}"
                                                            TextColor="#303342" />
                                                        <ActivityIndicator
                                                            Grid.Column="1"
                                                            Margin="0,0,7,0"
                                                            HeightRequest="18"
                                                            IsRunning="{Binding IsWordLookupLoading}"
                                                            IsVisible="{Binding IsWordLookupLoading}"
                                                            WidthRequest="18" />
