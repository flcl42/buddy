                                                <Border.Triggers>
                                                    <DataTrigger
                                                        Binding="{Binding AttentionKey}"
                                                        TargetType="Border"
                                                        Value="Review">
                                                        <Setter Property="BackgroundColor" Value="#FFF7E3" />
                                                        <Setter Property="Stroke" Value="#E9C86C" />
                                                    </DataTrigger>
                                                    <DataTrigger
                                                        Binding="{Binding AttentionKey}"
                                                        TargetType="Border"
                                                        Value="LikelyIssue">
                                                        <Setter Property="BackgroundColor" Value="#FFF0F0" />
                                                        <Setter Property="Stroke" Value="#E99A9A" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <VerticalStackLayout Spacing="0">
                                                    <Label
                                                        FontFamily="Segoe UI Semibold"
                                                        FontSize="12"
                                                        Text="{Binding Text}"
                                                        TextColor="#292C3D" />
                                                    <Label
                                                        FontSize="10"
                                                        Text="{Binding ConfidenceText}"
                                                        TextColor="#707589" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>

                                <FlexLayout
                                    AlignItems="Center"
                                    Direction="Row"
                                    IsVisible="{Binding HasTrainerPronunciation}"
                                    Wrap="Wrap">
