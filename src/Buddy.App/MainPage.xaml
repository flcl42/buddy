<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Buddy.App.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:cards="clr-namespace:Buddy.App.ViewModels"
    xmlns:controls="clr-namespace:Buddy.App.Controls"
    xmlns:vm="clr-namespace:Buddy.App.ViewModels"
    x:DataType="vm:MainViewModel"
    BackgroundColor="#F4F6FA"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#5B5CE2" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontFamily" Value="Segoe UI Semibold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="42" />
                <Setter Property="Padding" Value="18,0" />
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#EEF0F7" />
                <Setter Property="TextColor" Value="#25283A" />
                <Setter Property="FontFamily" Value="Segoe UI Semibold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="40" />
                <Setter Property="Padding" Value="16,0" />
            </Style>

            <Style x:Key="QuietButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="#60657A" />
                <Setter Property="FontFamily" Value="Segoe UI Semibold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="HeightRequest" Value="38" />
                <Setter Property="Padding" Value="12,0" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="Label">
                <Setter Property="TextColor" Value="#191B29" />
                <Setter Property="FontFamily" Value="Segoe UI Semibold" />
                <Setter Property="FontSize" Value="24" />
            </Style>

            <Style x:Key="MutedText" TargetType="Label">
                <Setter Property="TextColor" Value="#767B91" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="AppPicker" TargetType="controls:FramedPicker">
                <Setter Property="BackgroundColor" Value="#F8F9FC" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="TextColor" Value="#222538" />
                <Setter Property="TitleColor" Value="#7C8194" />
            </Style>

            <Style x:Key="AppEntry" TargetType="controls:FramedEntry">
                <Setter Property="BackgroundColor" Value="#F8F9FC" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HeightRequest" Value="44" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="PlaceholderColor" Value="#858A9D" />
                <Setter Property="TextColor" Value="#222538" />
            </Style>

            <Style x:Key="AppEditor" TargetType="controls:FramedEditor">
                <Setter Property="BackgroundColor" Value="#F8F9FC" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalOptions" Value="Fill" />
                <Setter Property="PlaceholderColor" Value="#858A9D" />
                <Setter Property="TextColor" Value="#222538" />
            </Style>

            <Style
                x:Key="OnboardingPicker"
                BasedOn="{StaticResource AppPicker}"
                TargetType="controls:FramedPicker">
                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="TextColor" Value="#222538" />
            </Style>

            <Style
                x:Key="OnboardingEntry"
                BasedOn="{StaticResource AppEntry}"
                TargetType="controls:FramedEntry">
                <Setter Property="BackgroundColor" Value="#FFFFFF" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="TextColor" Value="#222538" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <controls:BuddyTrayIcon
            x:Name="TrayIcon"
            DoubleClickCommand="{Binding OpenWindowCommand}"
            LeftClickCommand="{Binding OpenWindowCommand}"
            NoLeftClickDelay="False"
            ToolTipText="{Binding Runtime.TrayToolTip}">
            <FlyoutBase.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        Command="{Binding ToggleMeetingRecordingCommand}"
                        Text="{Binding TrayRecordingMenuText}" />
                    <MenuFlyoutItem
                        Command="{Binding OpenMonologueCommand}"
                        Text="{DynamicResource TrayMonologue}" />
                    <MenuFlyoutItem
                        Command="{Binding OpenDialogCommand}"
                        Text="{DynamicResource TrayDialog}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Command="{Binding OpenWindowCommand}"
                        Text="{DynamicResource OpenBuddy}" />
                    <MenuFlyoutItem
                        Command="{Binding ToggleSettingsCommand}"
                        Text="{DynamicResource Settings}" />
                    <MenuFlyoutItem
                        Command="{Binding OpenFeedbackWindowCommand}"
                        Text="{DynamicResource Feedback}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Command="{Binding ExitApplicationCommand}"
                        Text="{DynamicResource ExitBuddy}" />
                </MenuFlyout>
            </FlyoutBase.ContextFlyout>
        </controls:BuddyTrayIcon>

        <Grid RowDefinitions="72,*">
            <Border
                Grid.Row="0"
                Padding="24,0"
                BackgroundColor="White"
                Stroke="#E8EAF0"
                StrokeThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
                    <HorizontalStackLayout
                        Grid.Column="0"
                        Spacing="11"
                        VerticalOptions="Center">
                        <Border
                            WidthRequest="36"
                            HeightRequest="36"
                            BackgroundColor="#111827"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10">
                            <Label
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                FontAttributes="Bold"
                                FontSize="21"
                                Text="b"
                                TextColor="White" />
                        </Border>
                        <VerticalStackLayout Spacing="-2" VerticalOptions="Center">
                            <Label
                                FontFamily="Segoe UI Semibold"
                                FontSize="18"
                                Text="{DynamicResource AppName}"
                                TextColor="#171926" />
                            <HorizontalStackLayout Spacing="6">
                                <Ellipse
                                    WidthRequest="7"
                                    HeightRequest="7"
                                    Fill="#32A071"
                                    VerticalOptions="Center" />
                                <Label
                                    FontSize="11"
                                    Text="{Binding Runtime.StatusText}"
                                    TextColor="#74798D" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout
                        Grid.Column="1"
                        HorizontalOptions="Center"
                        Spacing="12"
                        VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="4">
                            <Button
                                AutomationId="SpeakTabButton"
                                Command="{Binding SelectSpeakCommand}"
                                Style="{StaticResource QuietButton}"
                                Text="{DynamicResource SpeakTab}">
                                <Button.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsSpeakSelected}"
                                        TargetType="Button"
                                        Value="False">
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                        <Setter Property="BorderColor" Value="Transparent" />
                                        <Setter Property="BorderWidth" Value="0" />
                                        <Setter Property="TextColor" Value="#60657A" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsSpeakSelected}"
                                        TargetType="Button"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#5B5CE2" />
                                        <Setter Property="BorderColor" Value="#4546BE" />
                                        <Setter Property="BorderWidth" Value="1" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button
                                AutomationId="RecordingsTabButton"
                                Command="{Binding SelectRecordingsCommand}"
                                Style="{StaticResource QuietButton}"
                                Text="{DynamicResource RecordingsTab}">
                                <Button.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsRecordingsSelected}"
                                        TargetType="Button"
                                        Value="False">
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                        <Setter Property="BorderColor" Value="Transparent" />
                                        <Setter Property="BorderWidth" Value="0" />
                                        <Setter Property="TextColor" Value="#60657A" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsRecordingsSelected}"
                                        TargetType="Button"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="#5B5CE2" />
                                        <Setter Property="BorderColor" Value="#4546BE" />
                                        <Setter Property="BorderWidth" Value="1" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </HorizontalStackLayout>

                    </HorizontalStackLayout>

                    <Button
                        Grid.Column="2"
                        Command="{Binding ToggleMeetingRecordingCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Text="{Binding MeetingButtonText}" />

                    <Button
                        Grid.Column="3"
                        AutomationId="OpenFeedbackButton"
                        Command="{Binding OpenFeedbackCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Text="{DynamicResource Feedback}" />

                    <Button
                        Grid.Column="4"
                        SemanticProperties.Description="{DynamicResource OpenSettingsDescription}"
                        Command="{Binding ToggleSettingsCommand}"
                        FontSize="19"
                        Style="{StaticResource QuietButton}"
                        Text="⚙" />
                </Grid>
            </Border>

            <Grid
                Grid.Row="1"
                IsVisible="{Binding IsRecordingsSelected}"
                RowDefinitions="Auto,Auto,*">
                <Grid
                    Grid.Row="0"
                    Padding="28,24,28,16"
                    ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource SectionTitle}" Text="{DynamicResource RecordingsTab}" />
                        <Label
                            Style="{StaticResource MutedText}"
                            Text="{DynamicResource RecordingsIntro}" />
                        <Label
                            FontSize="11"
                            Text="{Binding AudioOperationMessage}"
                            TextColor="#B54736" />
                    </VerticalStackLayout>
                    <Button
                        Grid.Column="1"
                        Command="{Binding ToggleMeetingRecordingCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Text="{Binding MeetingButtonText}" />
                </Grid>

                <Grid
                    Grid.Row="1"
                    Padding="28,0,28,14"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12">
                    <Border
                        BackgroundColor="White"
                        Stroke="#DFE2EA"
                        StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label
                                Margin="14,0,6,0"
                                FontSize="16"
                                Text="⌕"
                                TextColor="#7D8296"
                                VerticalTextAlignment="Center" />
                            <controls:BorderlessEntry
                                Grid.Column="1"
                                Margin="0"
                                BackgroundColor="Transparent"
                                ClearButtonVisibility="WhileEditing"
                                Placeholder="{DynamicResource SearchPlaceholder}"
                                ReturnCommand="{Binding RefreshRecordingsCommand}"
                                Text="{Binding SearchText}" />
                        </Grid>
                    </Border>
                    <Button
                        Grid.Column="1"
                        Command="{Binding RefreshRecordingsCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Text="{DynamicResource Refresh}" />
                </Grid>

                <Grid Grid.Row="2" Padding="28,0,28,24">
                    <CollectionView
                        ItemsSource="{Binding Recordings}"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Default">
                        <CollectionView.EmptyView>
                            <Border
                                Margin="0,12,0,0"
                                Padding="42"
                                BackgroundColor="White"
                                Stroke="#DFE2EA"
                                StrokeShape="RoundRectangle 14">
                                <VerticalStackLayout
                                    HorizontalOptions="Center"
                                    Spacing="10">
                                    <Border
                                        WidthRequest="52"
                                        HeightRequest="52"
                                        BackgroundColor="#F0EFFF"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16">
                                        <Label
                                            HorizontalTextAlignment="Center"
                                            VerticalTextAlignment="Center"
                                            FontSize="24"
                                            Text="◉"
                                            TextColor="#5B5CE2" />
                                    </Border>
                                    <Label
                                        HorizontalTextAlignment="Center"
                                        Style="{StaticResource MutedText}"
                                        Text="{Binding RecordingsMessage}" />
                                </VerticalStackLayout>
                            </Border>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="cards:RecordingCardViewModel">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="16"
                                    BackgroundColor="White"
                                    Stroke="#E1E4EB"
                                    StrokeShape="RoundRectangle 12">
                                    <Grid
                                        ColumnDefinitions="Auto,*,Auto"
                                        ColumnSpacing="14"
                                        RowDefinitions="Auto,Auto,Auto,44,Auto">
                                        <Button
                                            Grid.RowSpan="5"
                                            WidthRequest="42"
                                            HeightRequest="42"
                                            BackgroundColor="#F0EFFF"
                                            BorderWidth="0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.PlayRecordingCommand}"
                                            CommandParameter="{Binding .}"
                                            CornerRadius="12"
                                            FontSize="17"
                                            IsEnabled="{Binding CanPlay}"
                                            Padding="0"
                                            SemanticProperties.Description="{Binding PlayButtonText}"
                                            Text="{Binding PlayIcon}"
                                            TextColor="#5B5CE2"
                                            VerticalOptions="Center">
                                        </Button>

                                        <Label
                                            Grid.Column="1"
                                            FontFamily="Segoe UI Semibold"
                                            FontSize="14"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Title}"
                                            TextColor="#252736" />
                                        <Label
                                            Grid.Column="2"
                                            HorizontalTextAlignment="End"
                                            FontFamily="Segoe UI Semibold"
                                            FontSize="13"
                                            Text="{Binding DurationText}"
                                            TextColor="#363949" />
                                        <HorizontalStackLayout
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Spacing="8">
                                            <Label
                                                FontSize="11"
                                                Text="{Binding DateText}"
                                                TextColor="#7A7F92" />
                                            <Label FontSize="11" Text="·" TextColor="#A0A4B2" />
                                            <Label
                                                FontSize="11"
                                                Text="{Binding SourceText}"
                                                TextColor="#5B5CE2" />
                                            <Label
                                                FontSize="11"
                                                Text="{Binding StatusText}"
                                                TextColor="#7A7F92" />
                                        </HorizontalStackLayout>
                                        <Label
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            FontSize="10"
                                            HorizontalTextAlignment="End"
                                            Text="{Binding SpeechDurationText}"
                                            TextColor="#8A8E9E" />

                                        <HorizontalStackLayout
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Spacing="16">
                                            <Button
                                                AutomationId="RecordingTranscriptButton"
                                                BackgroundColor="Transparent"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleRecordingTranscriptCommand}"
                                                CommandParameter="{Binding .}"
                                                FontFamily="Segoe UI Semibold"
                                                FontSize="11"
                                                HeightRequest="28"
                                                Padding="0"
                                                SemanticProperties.Description="{DynamicResource RecordingTranscriptDescription}"
                                                Text="{DynamicResource Transcript}"
                                                TextColor="#4F50C8" />
                                            <Button
                                                AutomationId="OpenDialogTranscriptLink"
                                                BackgroundColor="Transparent"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.Dialog.OpenSavedDialogCommand}"
                                                CommandParameter="{Binding .}"
                                                FontFamily="Segoe UI Semibold"
                                                FontSize="11"
                                                HeightRequest="28"
                                                IsVisible="{Binding IsDialog}"
                                                Padding="0"
                                                SemanticProperties.Description="{DynamicResource ReadSavedDialogDescription}"
                                                Text="{DynamicResource ReadFullDialog}"
                                                TextColor="#4F50C8" />
                                        </HorizontalStackLayout>

                                        <Grid
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="10">
                                            <controls:WaveformView
                                                HeightRequest="40"
                                                HorizontalOptions="Fill"
                                                IsEnabled="{Binding CanPlay}"
                                                Progress="{Binding PlaybackProgress}"
                                                Samples="{Binding WaveformSamples}"
                                                SeekCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SeekRecordingCommand}"
                                                SeekCommandParameter="{Binding .}"
                                        SemanticProperties.Description="{DynamicResource WaveformSeekDescription}"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                HorizontalTextAlignment="End"
                                                FontSize="10"
                                                Text="{Binding TimelineText}"
                                                TextColor="#72778A"
                                                VerticalTextAlignment="Center" />
                                        </Grid>

                                        <Border
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            Grid.ColumnSpan="2"
                                            Margin="0,10,0,0"
                                            Padding="14"
                                            BackgroundColor="#F7F8FC"
                                            IsVisible="{Binding IsTranscriptExpanded}"
                                            Stroke="#DDE0EC"
                                            StrokeShape="RoundRectangle 10">
                                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label
                                                            FontFamily="Segoe UI Semibold"
                                                            FontSize="13"
                                                            Text="{DynamicResource SmartTranscript}"
                                                            TextColor="#252736" />
                                                        <Label
                                                            FontSize="10"
                                                            IsVisible="{Binding HasTranscript}"
                                                            Text="{Binding TranscriptProvenanceText}"
                                                            TextColor="#7A7F92" />
                                                    </VerticalStackLayout>
                                                    <ActivityIndicator
                                                        Grid.Column="1"
                                                        WidthRequest="20"
                                                        HeightRequest="20"
                                                        Color="#5B5CE2"
                                                        IsRunning="{Binding IsTranscribing}"
                                                        IsVisible="{Binding IsTranscribing}" />
                                                </Grid>

                                                <Grid Grid.Row="1">
                                                    <controls:FramedEditor
                                                        AutomationId="RecordingTranscriptEditor"
                                                        AutoSize="TextChanges"
                                                        IsReadOnly="{Binding IsTranscribing}"
                                                        IsVisible="{Binding HasTranscript}"
                                                        MaximumHeightRequest="220"
                                                        MinimumHeightRequest="92"
                                                        Placeholder="{DynamicResource TranscriptPlaceholder}"
                                                        Style="{StaticResource AppEditor}"
                                                        Text="{Binding TranscriptText, Mode=TwoWay}"
                                                        TextColor="#252736" />
                                                    <Label
                                                        FontSize="12"
                                                        IsVisible="{Binding NeedsTranscript}"
                                                        LineBreakMode="WordWrap"
                                                        Text="{DynamicResource NoTranscriptYet}"
                                                        TextColor="#666B7D" />
                                                </Grid>

                                                <FlexLayout
                                                    Grid.Row="2"
                                                    AlignItems="Center"
                                                    Direction="Row"
                                                    JustifyContent="Start"
                                                    Wrap="Wrap">
                                                    <Button
                                                        Margin="0,0,8,6"
                                                        AutomationId="TranscribeRecordingButton"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RequestRecordingTranscriptionCommand}"
                                                        CommandParameter="{Binding .}"
                                                        IsEnabled="{Binding CanRequestTranscription}"
                                                        IsVisible="{Binding NeedsTranscript}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Text="{DynamicResource TranscribeRecording}" />
                                                    <Button
                                                        Margin="0,0,8,6"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RequestRecordingTranscriptionCommand}"
                                                        CommandParameter="{Binding .}"
                                                        IsEnabled="{Binding CanRequestTranscription}"
                                                        IsVisible="{Binding HasTranscript}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Text="{DynamicResource TranscribeAgain}" />
                                                    <Button
                                                        Margin="0,0,8,6"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SaveRecordingTranscriptCommand}"
                                                        CommandParameter="{Binding .}"
                                                        IsEnabled="{Binding CanSaveTranscript}"
                                                        IsVisible="{Binding HasTranscript}"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Text="{DynamicResource SaveTranscript}" />
                                                    <Button
                                                        Margin="0,0,8,6"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CopyRecordingTranscriptCommand}"
                                                        CommandParameter="{Binding .}"
                                                        IsVisible="{Binding HasTranscript}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Text="{DynamicResource Copy}" />
                                                    <Button
                                                        Margin="0,0,0,6"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleRecordingTranscriptCommand}"
                                                        CommandParameter="{Binding .}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        Text="{DynamicResource Close}" />
                                                </FlexLayout>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <ActivityIndicator
                        HorizontalOptions="Center"
                        IsRunning="{Binding IsLoading}"
                        IsVisible="{Binding IsLoading}"
                        Color="#5B5CE2"
                        VerticalOptions="Center" />
                </Grid>

                <Grid
                    Grid.RowSpan="3"
                    Padding="28,22,28,24"
                    AutomationId="SavedDialogReader"
                    BackgroundColor="#F4F6FA"
                    IsVisible="{Binding Dialog.IsSavedDialogOpen}"
                    RowDefinitions="Auto,*"
                    ZIndex="5">
                    <Grid
                        Margin="0,0,0,14"
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="16">
                        <VerticalStackLayout Spacing="3">
                            <Label
                                FontFamily="Segoe UI Semibold"
                                FontSize="22"
                                LineBreakMode="TailTruncation"
                                Text="{Binding Dialog.SavedDialogTitle}"
                                TextColor="#191B29" />
                            <Label
                                FontSize="12"
                                Text="{Binding Dialog.SavedDialogMetadata}"
                                TextColor="#767B91" />
                            <Label
                                FontSize="11"
                                Text="{Binding Dialog.SavedDialogStatus}"
                                TextColor="#5B5CE2" />
                            <Label
                                FontSize="11"
                                LineBreakMode="WordWrap"
                                Text="{Binding Dialog.OperationMessage}"
                                TextColor="#B54736" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="1"
                            AutomationId="CloseSavedDialogButton"
                            Command="{Binding Dialog.CloseSavedDialogCommand}"
                            SemanticProperties.Description="{DynamicResource CloseSavedDialogDescription}"
                            Style="{StaticResource SecondaryButton}"
                            Text="{DynamicResource BackToRecordings}" />
                    </Grid>

                    <Border
                        Grid.Row="1"
                        Padding="16"
                        BackgroundColor="White"
                        Stroke="#DFE2EA"
                        StrokeShape="RoundRectangle 14">
                        <Grid>
                            <CollectionView
                                AutomationId="SavedDialogMessages"
                                ItemSizingStrategy="MeasureAllItems"
                                ItemsSource="{Binding Dialog.SavedMessages}"
                                SelectionMode="None"
                                VerticalScrollBarVisibility="Default">
                                <CollectionView.EmptyView>
                                    <VerticalStackLayout
                                        Padding="36"
                                        HorizontalOptions="Center"
                                        Spacing="10"
                                        VerticalOptions="Center">
                                        <Label
                                            HorizontalTextAlignment="Center"
                                            FontSize="26"
                                            Text="◇"
                                            TextColor="#B4B7C5" />
                                        <Label
                                            HorizontalTextAlignment="Center"
                                            LineBreakMode="WordWrap"
                                            Text="{Binding Dialog.SavedDialogStatus}"
                                            TextColor="#767B91" />
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="cards:DialogMessageViewModel">
                                        <controls:DialogMessageCardView />
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <ActivityIndicator
                                HorizontalOptions="Center"
                                IsRunning="{Binding Dialog.IsSavedDialogLoading}"
                                IsVisible="{Binding Dialog.IsSavedDialogLoading}"
                                Color="#5B5CE2"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid
                Grid.Row="1"
                AutomationId="SpeakModeChooser"
                IsVisible="{Binding IsSpeakModeChooserVisible}"
                Padding="40,34,40,40"
                RowDefinitions="Auto,24,*">
                <VerticalStackLayout
                    Grid.Row="0"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="760"
                    Spacing="6">
                    <Label
                        HorizontalTextAlignment="Center"
                        Style="{StaticResource SectionTitle}"
                        Text="{DynamicResource SpeakChooserTitle}" />
                    <Label
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Style="{StaticResource MutedText}"
                        Text="{DynamicResource SpeakChooserIntro}" />
                </VerticalStackLayout>

                <Grid
                    Grid.Row="2"
                    ColumnDefinitions="*,22,*"
                    HorizontalOptions="Fill"
                    MaximumWidthRequest="1080"
                    VerticalOptions="Fill">
                    <Border
                        Grid.Column="0"
                        AutomationId="DialogChoicePanel"
                        BackgroundColor="#F8F7FF"
                        Stroke="#C9C8F8"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="1.5">
                        <Border.Shadow>
                            <Shadow Brush="#160B1020" Offset="0,5" Opacity="0.3" Radius="18" />
                        </Border.Shadow>
                        <Grid
                            Padding="30"
                            RowDefinitions="Auto,Auto,*,Auto,Auto"
                            RowSpacing="16">
                            <Border
                                Grid.Row="0"
                                WidthRequest="58"
                                HeightRequest="58"
                                BackgroundColor="#E5E4FF"
                                HorizontalOptions="Start"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18">
                                <Label
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center"
                                    FontFamily="Segoe UI Semibold"
                                    FontSize="25"
                                    Text="↔"
                                    TextColor="#4B4CC3" />
                            </Border>
                            <Label
                                Grid.Row="1"
                                FontFamily="Segoe UI Semibold"
