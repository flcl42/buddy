                AutomationId="FeedbackBackdrop"
                BackgroundColor="#660B1020">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Feedback.CloseCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border
                AutomationId="FeedbackPanel"
                Margin="24"
                Padding="26"
                BackgroundColor="White"
                HorizontalOptions="Center"
                InputTransparent="False"
                MaximumWidthRequest="640"
                Stroke="#D8DBE6"
                StrokeShape="RoundRectangle 20"
                VerticalOptions="Center"
                WidthRequest="620">
                <Border.Shadow>
                    <Shadow Brush="#33000000" Offset="0,10" Opacity="0.35" Radius="26" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="17">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3">
                            <Label
                                FontFamily="Segoe UI Semibold"
                                FontSize="23"
                                Text="{DynamicResource FeedbackTitle}"
                                TextColor="#1D1F2C" />
                            <Label
                                Style="{StaticResource MutedText}"
                                Text="{DynamicResource FeedbackIntro}" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="1"
                            Command="{Binding Feedback.CloseCommand}"
                            FontSize="16"
                            Style="{StaticResource QuietButton}"
                            Text="✕" />
                    </Grid>

                    <VerticalStackLayout Spacing="7">
                        <Label
                            FontFamily="Segoe UI Semibold"
                            FontSize="13"
                            Text="{DynamicResource FeedbackMessage}" />
                        <Border
                            Padding="10,6"
                            BackgroundColor="#F7F8FC"
                            Stroke="#9DA4B8"
                            StrokeShape="RoundRectangle 11"
                            StrokeThickness="1.25">
                            <controls:BorderlessEditor
                                AutomationId="FeedbackMessageEditor"
                                AutoSize="TextChanges"
                                BackgroundColor="Transparent"
                                HeightRequest="145"
                                IsEnabled="{Binding Feedback.CanEdit}"
                                MaxLength="3000"
                                Placeholder="{DynamicResource FeedbackPlaceholder}"
                                Text="{Binding Feedback.Message}" />
                        </Border>
                        <Label
                            FontSize="10"
                            HorizontalTextAlignment="End"
                            Text="{Binding Feedback.CharacterCountText}"
                            TextColor="#777C8E" />
                    </VerticalStackLayout>

                    <Border
                        Padding="14,12"
                        BackgroundColor="#F7F8FC"
                        Stroke="#E0E3EC"
                        StrokeShape="RoundRectangle 12">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="10"
                            RowSpacing="7">
                            <VerticalStackLayout Spacing="2">
                                <Label
                                    FontFamily="Segoe UI Semibold"
                                    FontSize="13"
                                    Text="{DynamicResource FeedbackOptionalScreenshot}" />
                                <Label
                                    FontSize="11"
                                    Text="{DynamicResource FeedbackChooseImage}"
                                    TextColor="#73788B" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="1"
                                AutomationId="FeedbackAttachScreenshotButton"
                                Command="{Binding Feedback.AttachScreenshotCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Text="{DynamicResource FeedbackAttachScreenshot}" />
                            <Label
                                Grid.Row="1"
                                FontSize="11"
                                IsVisible="{Binding Feedback.HasScreenshot}"
                                LineBreakMode="TailTruncation"
                                Text="{Binding Feedback.ScreenshotSummary}"
                                TextColor="#3C6956" />
                            <Button
                                Grid.Row="1"
                                Grid.Column="1"
                                Command="{Binding Feedback.RemoveScreenshotCommand}"
                                IsVisible="{Binding Feedback.HasScreenshot}"
                                Padding="10,0"
                                Style="{StaticResource QuietButton}"
                                Text="{DynamicResource FeedbackRemoveScreenshot}" />
                        </Grid>
                    </Border>

                    <Border
                        Padding="12,10"
                        BackgroundColor="#FFF8E8"
                        Stroke="#F0D9A4"
                        StrokeShape="RoundRectangle 10">
                        <Label
                            FontSize="11"
                            LineBreakMode="WordWrap"
                            Text="{DynamicResource FeedbackPrivacy}"
                            TextColor="#775719" />
                    </Border>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <HorizontalStackLayout Spacing="9" VerticalOptions="Center">
                            <ActivityIndicator
                                IsRunning="{Binding Feedback.IsBusy}"
                                IsVisible="{Binding Feedback.IsBusy}"
                                Color="#5B5CE2" />
                            <Label
                                FontSize="11"
                                LineBreakMode="WordWrap"
                                Text="{Binding Feedback.StatusMessage}"
                                TextColor="#5055A5"
                                VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <Button
                            Grid.Column="1"
                            Command="{Binding Feedback.CloseCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Text="{DynamicResource Cancel}" />
                        <Button
                            Grid.Column="2"
                            AutomationId="FeedbackSendButton"
                            Command="{Binding Feedback.SendCommand}"
                            IsEnabled="{Binding Feedback.CanSend}"
                            Style="{StaticResource PrimaryButton}"
                            Text="{DynamicResource FeedbackSend}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Border
            Margin="24"
            Padding="14,12"
            BackgroundColor="#FFFFFF"
            HorizontalOptions="End"
            IsVisible="{Binding LocalSetup.IsVisible}"
            MaximumWidthRequest="430"
            MinimumWidthRequest="360"
            Stroke="#D8DAE5"
            StrokeShape="RoundRectangle 12"
            VerticalOptions="End"
            ZIndex="100">
            <Border.Shadow>
                <Shadow Brush="#33000000" Offset="0,4" Opacity="0.35" Radius="12" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
                <Label
                    FontFamily="Segoe UI Semibold"
                    FontSize="13"
                    Text="{Binding LocalSetup.Title}"
                    TextColor="#242635" />
                <Button
                    Grid.Column="1"
                    Command="{Binding LocalSetup.CancelCommand}"
                    IsVisible="{Binding LocalSetup.IsActive}"
                    Padding="8,2"
                    Style="{StaticResource QuietButton}"
                    Text="{DynamicResource Pause}" />
                <Label
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    FontSize="11"
                    LineBreakMode="WordWrap"
                    Text="{Binding LocalSetup.Detail}"
                    TextColor="#64697B" />
                <ProgressBar
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,0"
                    Progress="{Binding LocalSetup.Progress}"
                    ProgressColor="#5B5CE2" />
            </Grid>
        </Border>

        <Grid
            BackgroundColor="#F4F6FA"
            IsVisible="{Binding Onboarding.IsVisible}"
            InputTransparent="False"
            ZIndex="1000">
            <Border
                Margin="28"
                Padding="34"
                BackgroundColor="White"
                HorizontalOptions="Center"
                MaximumWidthRequest="780"
                WidthRequest="760"
                Stroke="#E0E3EC"
                StrokeShape="RoundRectangle 22"
                VerticalOptions="Fill">
                <Border.Shadow>
                    <Shadow Brush="#22000000" Offset="0,10" Opacity="0.35" Radius="28" />
                </Border.Shadow>

                <Grid>
                <ScrollView IsVisible="{Binding Onboarding.IsSetupStep}">
                    <VerticalStackLayout Spacing="18">
                        <VerticalStackLayout Spacing="5">
                            <Label
                                FontFamily="Segoe UI Semibold"
                                FontSize="29"
                                Text="{DynamicResource OnboardingTitle}"
                                TextColor="#171926" />
                            <Label
                                FontSize="14"
                                LineBreakMode="WordWrap"
                                Text="{DynamicResource OnboardingIntro}"
                                TextColor="#666B7E" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                            <VerticalStackLayout Spacing="6">
                                <Label
                                    FontFamily="Segoe UI Semibold"
                                    FontSize="13"
                                    Text="{DynamicResource InterfaceLanguage}" />
                                <controls:FramedPicker
                                    AutomationId="OnboardingInterfaceLanguagePicker"
                                    IsEnabled="{Binding Onboarding.CanEdit}"
                                    ItemsSource="{Binding Onboarding.InterfaceLanguageNames}"
                                    SelectedIndex="{Binding Onboarding.SelectedInterfaceLanguageIndex}"
                                    Style="{StaticResource OnboardingPicker}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label
                                    FontFamily="Segoe UI Semibold"
                                    FontSize="13"
                                    Text="{DynamicResource DialogLanguage}" />
                                <controls:FramedPicker
                                    AutomationId="OnboardingDialogLanguagePicker"
                                    IsEnabled="{Binding Onboarding.CanEdit}"
                                    ItemsSource="{Binding Onboarding.DialogLanguageNames}"
                                    SelectedIndex="{Binding Onboarding.SelectedDialogLanguageIndex}"
                                    Style="{StaticResource OnboardingPicker}" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Label
                                FontFamily="Segoe UI Semibold"
                                FontSize="13"
                                Text="{DynamicResource ChatbotPlatform}" />
                            <controls:FramedPicker
                                AutomationId="OnboardingProviderPicker"
                                IsEnabled="{Binding Onboarding.CanEdit}"
                                ItemsSource="{Binding Onboarding.ProviderNames}"
                                SelectedIndex="{Binding Onboarding.SelectedProviderIndex}"
                                Style="{StaticResource OnboardingPicker}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            IsVisible="{Binding Onboarding.IsTrialSelected}"
                            Spacing="5">
                            <Label
                                FontFamily="Segoe UI Semibold"
                                FontSize="13"
                                Text="{DynamicResource TrialCode}" />
                            <controls:FramedEntry
                                AutomationId="OnboardingTrialCodeEntry"
                                CharacterSpacing="1.5"
                                FontFamily="Segoe UI Semibold"
                                IsEnabled="{Binding Onboarding.CanEdit}"
                                MaxLength="13"
                                Placeholder="{DynamicResource TrialCodePlaceholder}"
                                Style="{StaticResource OnboardingEntry}"
                                Text="{Binding Onboarding.TrialCode}" />
                            <Label
                                FontSize="11"
                                IsVisible="{Binding Onboarding.HasIncludedTrialCode}"
                                Text="{DynamicResource SetupIncludedCode}"
                                TextColor="#777C8E" />
                        </VerticalStackLayout>

                        <VerticalStackLayout
                            IsVisible="{Binding Onboarding.IsDeepSeekSelected}"
                            Spacing="5">
                            <Label
                                FontFamily="Segoe UI Semibold"
                                FontSize="13"
                                Text="{DynamicResource DeepSeekKey}" />
                            <controls:FramedEntry
                                AutomationId="OnboardingDeepSeekKeyEntry"
                                IsEnabled="{Binding Onboarding.CanEdit}"
                                IsPassword="True"
                                Style="{StaticResource OnboardingEntry}"
                                Text="{Binding Onboarding.DeepSeekApiKey}" />
                            <Button
                                AutomationId="OnboardingDeepSeekApiKeyGuideButton"
                                Command="{Binding Settings.OpenDeepSeekApiKeyGuideCommand}"
                                HorizontalOptions="Start"
                                SemanticProperties.Description="{DynamicResource DeepSeekKeyGuide}"
                                Style="{StaticResource QuietButton}"
                                Text="{DynamicResource DeepSeekKeyGuide}" />
                        </VerticalStackLayout>

                        <Border
                            AutomationId="OnboardingDownloadConsent"
                            Padding="13,10"
                            BackgroundColor="#F0F2FF"
                            Stroke="#D9DAFA"
                            StrokeShape="RoundRectangle 10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                <Label
                                    FontFamily="Segoe UI Semibold"
                                    FontSize="16"
                                    Text="↓"
                                    TextColor="#5051C7"
                                    VerticalTextAlignment="Center" />
                                <Label
                                    Grid.Column="1"
                                    FontSize="12"
                                    LineBreakMode="WordWrap"
                                    Text="{DynamicResource SetupDownloadConsent}"
                                    TextColor="#4E5270"
                                    VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border
                            Padding="16"
                            BackgroundColor="#F7F8FC"
                            Stroke="#E5E7F0"
                            StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="12">
                                <Label
                                    FontFamily="Segoe UI Semibold"
                                    FontSize="14"
                                    Text="{DynamicResource SetupRequiredFiles}" />

                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                    <Label Text="{DynamicResource SetupWhisper}" />
                                    <Label Grid.Column="1" FontSize="11" Text="{Binding Onboarding.WhisperStatus}" TextColor="#666B7E" />
                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0" Progress="{Binding Onboarding.WhisperProgress}" ProgressColor="#5B5CE2" />
                                </Grid>
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                    <Label Text="{DynamicResource SetupVad}" />
                                    <Label Grid.Column="1" FontSize="11" Text="{Binding Onboarding.VadStatus}" TextColor="#666B7E" />
                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0" Progress="{Binding Onboarding.VadProgress}" ProgressColor="#5B5CE2" />
                                </Grid>
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                    <Label Text="{DynamicResource SetupVoice}" />
                                    <Label Grid.Column="1" FontSize="11" Text="{Binding Onboarding.VoiceStatus}" TextColor="#666B7E" />
                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0" Progress="{Binding Onboarding.VoiceProgress}" ProgressColor="#5B5CE2" />
                                </Grid>
                                <Grid
                                    IsVisible="{Binding Onboarding.ShouldShowQwenProgress}"
                                    RowDefinitions="Auto,Auto"
                                    ColumnDefinitions="*,Auto">
                                    <Label Text="{DynamicResource SetupQwen}" />
                                    <Label Grid.Column="1" FontSize="11" Text="{Binding Onboarding.QwenStatus}" TextColor="#666B7E" />
                                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,5,0,0" Progress="{Binding Onboarding.QwenProgress}" ProgressColor="#5B5CE2" />
                                </Grid>
                                <Label
                                    FontSize="11"
                                    IsVisible="{Binding Onboarding.IsQwenSelected}"
                                    LineBreakMode="WordWrap"
                                    Text="{DynamicResource SetupQwenNotice}"
                                    TextColor="#7B5A18" />
                            </VerticalStackLayout>
                        </Border>

                        <Label
                            FontSize="12"
                            IsVisible="{Binding Onboarding.HasError}"
                            LineBreakMode="WordWrap"
                            Text="{Binding Onboarding.StatusMessage}"
                            TextColor="#B13B3B" />
                        <Label
                            FontSize="12"
                            IsVisible="{Binding Onboarding.IsInstalling}"
                            Text="{Binding Onboarding.StatusMessage}"
                            TextColor="#5B5CE2" />
                        <Button
                            AutomationId="OnboardingSetupButton"
                            Command="{Binding Onboarding.RunSetupCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Text="{Binding Onboarding.SetupButtonText}" />
                    </VerticalStackLayout>
                </ScrollView>

                <VerticalStackLayout
                    HorizontalOptions="Center"
                    IsVisible="{Binding Onboarding.IsCompletionStep}"
                    MaximumWidthRequest="560"
                    Spacing="14"
                    VerticalOptions="Center">
                    <Label
                        FontSize="62"
                        HorizontalTextAlignment="Center"
                        Text="{DynamicResource SetupParty}" />
                    <Label
                        FontFamily="Segoe UI Semibold"
                        FontSize="31"
                        HorizontalTextAlignment="Center"
                        Text="{DynamicResource SetupDoneTitle}"
                        TextColor="#171926" />
                    <Label
                        FontSize="16"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{DynamicResource SetupDoneInstruction}"
                        TextColor="#626779" />
                    <Button
                        AutomationId="OnboardingFinishButton"
                        Command="{Binding Onboarding.FinishCommand}"
                        Margin="0,12,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Text="{DynamicResource SetupFinish}" />
                </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
