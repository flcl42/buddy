                                                        IsVisible="{Binding HasWordLookupError}"
                                                        LineBreakMode="WordWrap"
                                                        Text="{Binding WordLookupError}"
                                                        TextColor="#B54736" />
                                                </VerticalStackLayout>
                                            </Border>
                                            <Border
