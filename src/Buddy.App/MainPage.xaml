                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="14">
                        <Border
                            Padding="20"
                            BackgroundColor="White"
                            Stroke="#E0E3EA"
                            StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="14">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label
                                            FontFamily="Segoe UI Semibold"
                                            FontSize="15"
                                            Text="{DynamicResource PracticeTake}"
                                            TextColor="#242635" />
                                        <Label
                                            Style="{StaticResource MutedText}"
                                            Text="{DynamicResource OriginalAudioPreserved}" />
                                    </VerticalStackLayout>
                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding RecordTrainerTakeCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Text="{Binding TrainerRecordingButtonText}" />
                                </Grid>

                                <Border
                                    Padding="14,10"
                                    BackgroundColor="#F7F8FB"
                                    Stroke="#E4E6EC"
                                    StrokeShape="RoundRectangle 10">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Button
