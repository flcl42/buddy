                                    HorizontalOptions="Center"
                                    IsRunning="{Binding IsTrainerBusy}"
                                    IsVisible="{Binding IsTrainerBusy}"
                                    Color="#5B5CE2" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
