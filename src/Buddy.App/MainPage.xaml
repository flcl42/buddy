                                    </Grid>
                                </Border>
                                <Label
                                    FontSize="11"
                                    Text="{Binding TrainerStatusMessage}"
                                    TextColor="#656B7F" />
                            </VerticalStackLayout>
                        </Border>

                        <Border
                            Padding="20"
                            BackgroundColor="White"
                            Stroke="#E0E3EA"
                            StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label
                                        FontFamily="Segoe UI Semibold"
                                        FontSize="15"
                                        Text="{DynamicResource WhatISaid}"
                                        TextColor="#242635" />
                                    <Label
                                        Grid.Column="1"
                                        FontSize="11"
                                        Text="{DynamicResource Editable}"
                                        TextColor="#5B5CE2" />
                                </Grid>
                                <controls:FramedEditor
                                    AutoSize="TextChanges"
                                    HeightRequest="190"
                                    Placeholder="{DynamicResource RecognizedTextPlaceholder}"
                                    Style="{StaticResource AppEditor}"
