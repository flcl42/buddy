                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Label
                                                    FontSize="11"
                                                    Text="{Binding .}"
                                                    TextColor="#52627E" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout
                                        BindableLayout.ItemsSource="{Binding TrainerProtectedWarnings}"
                                        Spacing="4">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Label
                                                    FontSize="11"
                                                    Text="{Binding .}"
                                                    TextColor="#A15C1B" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <Border
                                Padding="14"
                                BackgroundColor="#FFF9EC"
                                IsVisible="{Binding HasTrainerAmbiguities}"
                                Stroke="#F0D9A4"
                                StrokeShape="RoundRectangle 10">
                                <VerticalStackLayout Spacing="6">
                                    <Label
                                        FontFamily="Segoe UI Semibold"
                                        FontSize="12"
                                                Text="{DynamicResource MeaningNeedsReview}"
                                        TextColor="#815B16" />
                                    <VerticalStackLayout
                                        BindableLayout.ItemsSource="{Binding TrainerAmbiguityNotes}"
                                        Spacing="4">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Label
                                                    FontSize="11"
                                                    Text="{Binding .}"
                                                    TextColor="#815B16" />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="10">
                                <controls:FramedPicker
                                    ItemsSource="{Binding TrainerVoiceNames}"
                                    SelectedIndex="{Binding SelectedTrainerVoiceIndex}"
                                    Style="{StaticResource AppPicker}"
                                    Title="{DynamicResource Voice}" />
                                <controls:FramedPicker
                                    Grid.Column="1"
                                    ItemsSource="{Binding TrainerSpeedNames}"
                                    SelectedIndex="{Binding TrainerSpeedIndex}"
                                    Style="{StaticResource AppPicker}"
                                    Title="{DynamicResource Pace}" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding SynthesizeTrainerTextCommand}"
                                    IsEnabled="{Binding CanSynthesizeTrainerText}"
                                    Style="{StaticResource PrimaryButton}"
                                    Text="{DynamicResource CreateBetterAudio}" />
                            </Grid>

                            <Border
                                Padding="14,12"
                                BackgroundColor="#F1F0FF"
                                Stroke="#DAD8FF"
                                StrokeShape="RoundRectangle 10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <Button
                                        Command="{Binding PlayTrainerGeneratedCommand}"
                                        IsEnabled="{Binding IsTrainerGeneratedAudioAvailable}"
                                        Style="{StaticResource QuietButton}"
                                        Text="{Binding TrainerGeneratedPlaybackButtonText}" />
                                    <Label
                                        Grid.Column="1"
                                        FontSize="12"
                                        Text="{Binding TrainerGeneratedStatusText}"
                                        TextColor="#5D6072"
                                        VerticalTextAlignment="Center" />
                                    <Label
                                        Grid.Column="2"
                                        FontSize="11"
                                        Text="{DynamicResource LocalWav}"
                                        TextColor="#4F50C8" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </ScrollView>

            <Grid
                Grid.Row="1"
                Padding="28,24,28,28"
                ColumnDefinitions="*,18,330"
                IsVisible="{Binding IsDialogMode}"
                RowDefinitions="Auto,*">
                <Grid
                    Grid.Row="0"
                    Grid.ColumnSpan="3"
                    Margin="0,0,0,18"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Style="{StaticResource SectionTitle}" Text="{DynamicResource DialogTab}" />
                        <Label
                            Style="{StaticResource MutedText}"
                            Text="{DynamicResource DialogIntro}" />
                    </VerticalStackLayout>
                    <Button
                        Grid.Column="1"
                        Command="{Binding Dialog.StartDialogCommand}"
                        IsEnabled="{Binding Dialog.CanStart}"
                        IsVisible="{Binding Dialog.IsInactive}"
                        Style="{StaticResource PrimaryButton}"
                        Text="{DynamicResource StartDialog}" />
                    <Button
                        Grid.Column="1"
                        Command="{Binding Dialog.FinishDialogCommand}"
                        IsEnabled="{Binding Dialog.CanFinish}"
                        IsVisible="{Binding Dialog.IsActive}"
                        Style="{StaticResource SecondaryButton}"
                        Text="{Binding Dialog.FinishButtonText}" />
                </Grid>

