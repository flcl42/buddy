                            BackgroundColor="White"
                            Stroke="#E0E3EA"
                            StrokeShape="RoundRectangle 14">
                            <VerticalStackLayout Spacing="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        FontFamily="Segoe UI Semibold"
                                        FontSize="15"
                                        Text="{DynamicResource PronunciationReview}"
                                        TextColor="#242635" />
                                    <Label
                                        Style="{StaticResource MutedText}"
                                        Text="{DynamicResource PronunciationReviewIntro}" />
                                </VerticalStackLayout>

                                <Label
                                    FontFamily="Segoe UI Semibold"
                                    FontSize="12"
                                    IsVisible="{Binding HasTrainerPronunciation}"
