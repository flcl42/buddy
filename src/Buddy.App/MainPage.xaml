                                        <Border
                                            BackgroundColor="#EDF8F0"
                                            HeightRequest="10"
                                            Stroke="#B7DDC1"
                                            StrokeShape="RoundRectangle 5"
                                            WidthRequest="10" />
                                        <Label
                                            FontSize="10"
                                            Text="{DynamicResource ClearRating}"
                                            TextColor="#686D80"
                                            VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Margin="0,0,14,4" Spacing="5">
                                        <Border
                                            BackgroundColor="#FFF7E3"
                                            HeightRequest="10"
                                            Stroke="#E9C86C"
                                            StrokeShape="RoundRectangle 5"
                                            WidthRequest="10" />
                                        <Label
                                            FontSize="10"
                                            Text="{DynamicResource ReviewRating}"
                                            TextColor="#686D80"
                                            VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Margin="0,0,14,4" Spacing="5">
                                        <Border
                                            BackgroundColor="#FFF0F0"
                                            HeightRequest="10"
                                            Stroke="#E99A9A"
                                            StrokeShape="RoundRectangle 5"
                                            WidthRequest="10" />
                                        <Label
                                            FontSize="10"
                                            Text="{DynamicResource UnclearRating}"
                                            TextColor="#686D80"
                                            VerticalTextAlignment="Center" />
                                    </HorizontalStackLayout>
                                </FlexLayout>

                                <Label
                                    FontSize="11"
                                    Text="{Binding TrainerPronunciationStatus}"
                                    TextColor="#767B91" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <Border
                        Grid.Row="1"
                        Grid.Column="2"
                        Padding="20"
                        BackgroundColor="White"
                        Stroke="#E0E3EA"
                        StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="13">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        FontFamily="Segoe UI Semibold"
                                        FontSize="15"
                                        Text="{DynamicResource BetterVersion}"
                                        TextColor="#242635" />
                                    <Label
                                        Style="{StaticResource MutedText}"
                                        Text="{DynamicResource BetterVersionIntro}" />
                                </VerticalStackLayout>
                                <Label
                                    Grid.Column="1"
                                    FontSize="11"
                                    Text="{DynamicResource Editable}"
                                    TextColor="#5B5CE2" />
                            </Grid>

                            <controls:FramedEditor
                                AutoSize="TextChanges"
                                HeightRequest="270"
                                Placeholder="{DynamicResource BetterVersionPlaceholder}"
                                Style="{StaticResource AppEditor}"
                                Text="{Binding TrainerImprovedText}" />

                            <Border
                                Padding="14"
                                BackgroundColor="#F3F7FF"
                                IsVisible="{Binding HasTrainerFeedback}"
                                Stroke="#C9D7F2"
                                StrokeShape="RoundRectangle 10">
